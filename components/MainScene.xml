<?xml version="1.0" encoding="utf-8" ?>
<component name="MainScene" extends="Scene">
  <script type="text/brightscript" uri="pkg:/components/MainScene.brs" />
  <interface>
    <field id="launchToken" type="string" />
    <field id="launchServer" type="string" />
  </interface>
  <children>
    <Rectangle id="background" width="1280" height="720" color="0x0B1020FF" />
    <Rectangle id="topBar" width="1280" height="108" color="0x121B33FF" />
    <Label id="title" text="Cartridge" translation="[64,28]" width="900" height="46" font="font:LargeBoldSystemFont" color="0xF8FAFCFF" />
    <Label id="subtitle" text="Your self-hosted retro library — works with RomM (unofficial)" translation="[66,74]" width="1200" height="24" font="font:SmallSystemFont" color="0x9FB3D9FF" />

    <LayoutGroup id="pairPanel" layoutDirection="vert" translation="[94,150]" itemSpacings="[18]">
      <Label text="Pair this Roku with RomM" width="1090" height="50" font="font:MediumBoldSystemFont" color="0xF8FAFCFF" />
      <Label id="pairInstructions" text="On romm.moveweight.com, create a read-only Client API Token and choose Pair to generate an 8-digit code." width="1090" height="54" wrap="true" maxLines="2" font="font:MediumSystemFont" color="0xC9D6F0FF" />
      <Rectangle width="1090" height="2" color="0x334B7AFF" />
      <Label id="pairCode" text="0 0 0 0   0 0 0 0" width="1090" height="78" horizAlign="center" font="font:LargeBoldSystemFont" color="0x7DD3FCFF" />
      <Label id="pairCursor" text="^" width="1090" height="32" horizAlign="center" font="font:MediumBoldSystemFont" color="0xFDE68AFF" />
      <Label text="Left / Right: choose a digit    Up / Down: change it    OK: pair" width="1090" height="30" horizAlign="center" font="font:SmallSystemFont" color="0xAAB9D6FF" />
      <Label id="pairHint" text="The pairing code is single-use and expires after five minutes." width="1090" height="30" horizAlign="center" font="font:SmallSystemFont" color="0x8093B8FF" />
    </LayoutGroup>

    <Label id="screenHeading" visible="false" translation="[64,136]" width="1150" height="44" font="font:MediumBoldSystemFont" color="0xF8FAFCFF" />
    <LabelList id="platformList" visible="false" translation="[64,194]" width="1150" height="448" itemSize="[1100,52]" itemSpacing="[0,8]" drawFocusFeedback="true" focusedColor="0x7DD3FCFF" color="0xD7E3F9FF" />
    <LabelList id="romList" visible="false" translation="[64,194]" width="1150" height="448" itemSize="[1100,52]" itemSpacing="[0,8]" drawFocusFeedback="true" focusedColor="0x7DD3FCFF" color="0xD7E3F9FF" />

    <!-- Instant search: pressing * (or the on-screen hint) over a game list opens
         this keyboard; every character re-queries the server with search_term so
         results filter as you type. -->
    <Label id="searchHint" visible="false" translation="[64,136]" width="1150" height="30" font="font:SmallSystemFont" color="0x7DD3FCFF" text="Press * to search" />
    <Group id="searchPanel" visible="false" translation="[64,150]">
      <Rectangle width="1150" height="470" color="0x0E1526F0" />
      <Label translation="[24,20]" width="1100" height="40" font="font:MediumBoldSystemFont" color="0xF8FAFCFF" text="Search games" />
      <MiniKeyboard id="searchKeyboard" translation="[24,70]" />
      <Label id="searchResults" translation="[560,80]" width="560" height="360" wrap="true" maxLines="14" font="font:SmallSystemFont" color="0xC9D6F0FF" />
      <Label translation="[24,430]" width="1100" height="26" font="font:SmallSystemFont" color="0xAAB9D6FF" text="Type to filter - OK on a result list below - Back to close search" />
    </Group>

    <LayoutGroup id="detailsPanel" visible="false" layoutDirection="vert" translation="[84,154]" itemSpacings="[12]">
      <Poster id="detailsCover" width="200" height="280" translation="[0,0]" />
      <Label id="detailsTitle" width="880" height="44" translation="[220,0]" font="font:MediumBoldSystemFont" color="0xF8FAFCFF" />
      <Label id="detailsPlatform" width="880" height="24" translation="[220,48]" font="font:SmallSystemFont" color="0x7DD3FCFF" />
      <Rectangle translation="[220,80]" width="880" height="2" color="0x334B7AFF" />
      <Label id="detailsSummary" width="880" height="90" translation="[220,90]" wrap="true" maxLines="3" font="font:MediumSystemFont" color="0xD7E3F9FF" />
      <Label id="detailsPlayHint" text="Press Play/Pause to launch game stream" width="800" height="26" translation="[220,200]" font="font:SmallSystemFont" color="0xFDE68AFF" />
      <Button id="playButton" text="▶ PLAY" translation="[220,230]" minWidth="200" height="48" focusedColor="0x7DD3FC" focusFootprintColor="0x7DD3FC33" />
      <Label text="Back: return to games" width="1100" height="26" translation="[0,360]" font="font:SmallSystemFont" color="0xAAB9D6FF" />
    </LayoutGroup>

    <Video id="gameVideo" visible="false" translation="[0,0]" width="1280" height="720" enableTrickPlay="false" />
    <Label id="streamStatus" visible="false" translation="[900,680]" width="360" height="28" font="font:SmallSystemFont" color="0x7DD3FCFF" />

    <Rectangle id="statusBar" translation="[0,662]" width="1280" height="58" color="0x121B33FF" />
    <Label id="status" translation="[64,678]" width="1140" height="28" font="font:SmallSystemFont" color="0xAAB9D6FF" />
  </children>
</component>
